# Golavo local configuration.
# Copy to `.env` for source-mode development. NEVER commit a real .env.
# Every key here is OPTIONAL — Golavo runs fully local with none of them.
# In the packaged macOS app, secrets live in Keychain. Windows/Linux use environment variables.

# --- Local server ---
GOLAVO_HOST=127.0.0.1
GOLAVO_PORT=0                 # 0 = OS-assigned ephemeral port
# GOLAVO_TOKEN is generated per launch by the desktop shell; do not set it here.

# --- CORS (the desktop shell sets this automatically) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,tauri://localhost

# --- Optional outside signals (dev only; the macOS app uses Keychain) ---
# Display-only Sportmonks predictions/odds. They never enter the statistical engine,
# seals, scoring, calibration, AI evidence, or exports. Requires explicit in-app consent.
# SPORTMONKS_API_TOKEN=

# --- Optional AI (Bring Your Own Key). Local models need no key. ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Local OpenAI-compatible endpoints (defaults shown):
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1

# --- AI spend caps (USD) --- reserved; NOT yet enforced (Phase 5). BYOK calls
# are opt-in and small; a hard cost meter is future work.
AI_PER_MATCH_CAP=0.05
AI_MONTHLY_CAP=5.00
